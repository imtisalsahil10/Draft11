# Secrets. Real connection strings stay in the host environment.
.env
.env.*
**/.env
**/.env.*
!**/.env.example

# Dependencies and generated builds
node_modules/
frontend/dist/
backend/dist/
.vite/
*.tsbuildinfo

# Playwright output and test results
test-results/
playwright-report/
blob-report/
playwright/.cache/
coverage/
.nyc_output/

# Python caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local database backups and catalogue snapshots that are not the live store
data/backups/
data/local-catalogue/backups/
data/image-catalogue/
data/local-test-rooms/
data/live-catalogue/

# OCR dumps and audit reports. The published catalogue.json stays tracked.
data/local-catalogue/audit.json
data/local-catalogue/card-ocr-audit.json
data/local-catalogue/card-ocr.jsonl
data/local-catalogue/card-readings.json
data/local-catalogue/card-readings.before-recovery.json
data/imports/fut23-identity-review.json
data/imports/fut23-last-run.json
data/imports/_reconcile-analysis.json
data/imports/_sheet-inspect.json

# Excel workbooks
*.xlsx
*.xls
*.xlsm

# Contact sheets and photo-audit working files
photo-audit/
**/contact-sheet*
**/contact-*.jpg
**/contact-*.png
**/contact-*.jpeg

# Identity-review working data and thumbnails
frontend/public/identity-thumbs/
frontend/public/identity-review.json

# Unreferenced local experiments. They are not part of the application or its tests.
backend/players/_reconcile-analyze.mjs
backend/players/_emit_wiki_names.mjs
backend/players/image_glyph_cluster.py

# Temporary logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor and OS files
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
