# Backend Server Configuration

# Server
PORT=3000
NODE_ENV=development

# MongoDB
# Local development only. Production sets the rotated Atlas URI on Render.
# Never commit a real password.
MONGODB_URI=mongodb://localhost:27017/football-auction
MONGODB_DB_NAME=football-auction

# Browser origins. Production reads ALLOWED_ORIGINS and rejects "*".
# Development also allows http://localhost and http://127.0.0.1 on any port.
ALLOWED_ORIGINS=http://localhost:5173

# Socket.IO
SOCKET_IO_PORT=3000
SOCKET_IO_CORS_ORIGIN=http://localhost:5173

# Game Settings
MAX_PLAYERS_PER_ROOM=5
AUCTION_TIMER_SECONDS=30
INITIAL_PLAYER_BALANCE=1000

# Local player photos stay off until both of these are set to 1 and a
# card is listed in data/player-image-approvals.json.
# DRAFT11_PLAYER_PHOTOS=0
